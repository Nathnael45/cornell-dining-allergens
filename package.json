{
  "name": "cornell-dining-allergens",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "db:up": "docker compose up -d --wait db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/cli.ts migrate",
    "ingest": "tsx scripts/cli.ts ingest",
    "ingest:file": "tsx scripts/cli.ts ingest:file",
    "netnutrition": "tsx scripts/cli.ts netnutrition",
    "prod:migrate": "tsx --env-file=.env.neon scripts/cli.ts migrate",
    "prod:ingest": "tsx --env-file=.env.neon scripts/cli.ts ingest",
    "prod:netnutrition": "tsx --env-file=.env.neon scripts/cli.ts netnutrition",
    "ai:check": "tsx scripts/ai-check.ts",
    "eval": "tsx eval/eval.ts",
    "research": "tsx scripts/cli.ts research",
    "prod:research": "tsx --env-file=.env.neon scripts/cli.ts research",
    "eval:gluten": "tsx eval/gluten.ts",
    "gluten": "tsx scripts/cli.ts gluten",
    "prod:gluten": "tsx --env-file=.env.neon scripts/cli.ts gluten",
    "refloor": "tsx scripts/cli.ts refloor",
    "prod:refloor": "tsx --env-file=.env.neon scripts/cli.ts refloor"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
